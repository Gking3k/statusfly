PORT=5000
CLIENT_URL=http://localhost:5173

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_STORAGE_BUCKET=statusfly-products

# StatusFly owner/admin access
STATUSFLY_ADMIN_USERNAME=admin
STATUSFLY_ADMIN_PASSWORD=replace-with-a-long-random-password
STATUSFLY_ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Used to encrypt stored private edit tokens so paid page links can be re-sent securely.
# Generate 32 random bytes encoded as 64 hexadecimal characters; keep it stable and secret.
STATUSFLY_EDIT_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters

# Public canonical frontend URL used in recovery and access emails.
PUBLIC_SITE_URL=https://statusfly.app

# Resend delivery (needed for page access and edit-link recovery emails).
RESEND_API_KEY=your-resend-api-key
PRODUCT_PAGE_FROM_EMAIL="StatusFly <pages@your-verified-domain.example>"
